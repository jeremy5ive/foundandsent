{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(grep:*)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git pull --ff-only --quiet 2>&1 && echo 'Repo synced with GitHub (git pull ok).' || echo 'WARNING: automatic git pull failed \u2014 run git status and resolve before editing.'"
          }
        ]
      }
    ]
  }
}
